{
  "name": "open-source-immersion-checker",
  "version": "6.0.0",
  "description": "Small app to see if you have fulfilled the requirements for a Open Source Immersion",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "npm run build && npm run start-server",
    "start-development": "npm-run-all -l -p \"start-frontend\" \"start-server\"",
    "start-frontend": "npm run tailwind-gen && react-scripts start",
    "start-server": "node index.js",
    "build": "npm run tailwind-gen && react-scripts build",
    "test": "react-scripts test --env=jsdom --roots=src --roots=api",
    "eject": "react-scripts eject",
    "tailwind-gen": "postcss ./src/style.css -o ./src/index.css",
    "eslint": "npm run prettier",
    "eslint-fix": "npm run prettier-fix",
    "prettier": "prettier \"{src,api}/**/*.js\"",
    "prettier-fix": "prettier --write \"{src,api}/**/*.js\""
  },
  "keywords": [
    "open-source-immersion"
  ],
  "author": "Ian Jenkins",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "html-react-parser": "^5.2.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.30.0",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17"
  },
  "repository": "git@github.com:prondubuisi/pr-checker.git",
  "jest": {
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}",
      "<rootDir>/api/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/api/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
